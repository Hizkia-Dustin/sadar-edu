PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS (>= 3.1)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SadarEdu

# Keamanan. WAJIB diganti & diisi pada production (server menolak start tanpa JWT_SECRET).
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=1d

# Origin FE yang diizinkan, dipisah koma. Kosong = semua origin (hanya untuk dev).
CORS_ORIGIN=http://localhost:5173

# Akun awal untuk `npm run seed:users`
SEED_OPERATOR_EMAIL=operator@sadaredu.id
SEED_OPERATOR_PASSWORD=ganti-password-operator
SEED_STAKEHOLDER_EMAIL=stakeholder@sadaredu.id
SEED_STAKEHOLDER_PASSWORD=ganti-password-stakeholder

# Parameter analisis (asumsi kerja; sesuaikan dengan regulasi Disdik)
# SISWA_PER_ROMBEL=32
# TARGET_APK=0.9
# COVERAGE_RADIUS_KM=3
# AMBANG_SISWA_PER_GURU=20
# AMBANG_BLANK_SPOT_PCT=30
